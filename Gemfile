source "https://rubygems.org"

# The github-pages gem pins Jekyll and all plugins to the exact versions
# GitHub's classic Pages build uses, so your local build matches production.
# jekyll-sitemap ships inside this gem, so listing it in _config.yml's
# `plugins:` is all you need to activate it.
gem "github-pages", group: :jekyll_plugins

# If you ever switch to building with GitHub Actions instead of the classic
# Pages build, replace the line above with these two:
#   gem "jekyll", "~> 4.3"
#   gem "jekyll-sitemap"
